# Copiá este archivo como .env para probar en tu compu (NO lo subas a GitHub).
# En Render, estas mismas variables se cargan en "Environment" (no en el repo).

# --- Anthropic (obligatoria para que responda con IA) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Kommo ---
KOMMO_SUBDOMAIN=tucuenta.kommo.com
KOMMO_TOKEN=
KOMMO_SECRET_KEY=

# --- Sitio / catálogo (ya tienen valor por defecto, se pueden dejar vacías) ---
CATEGORIAS_INDEX=7
REFRESCO_CATALOGO_MIN=30

# --- Vendedores (no sensible; se puede editar) ---
VENDEDORES=Erika:595984356888,Analía:595976655588,Fabián:595976667222
